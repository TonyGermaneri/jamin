{
  "name": "jamin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web MIDI chord chart that reads shorthand fakebook notation and plays it in sync with your DAW.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.compile.config.js",
    "preview": "vite preview",
    "serve": "python3 scripts/serve.py",
    "chords": "python3 scripts/build_chord_sets.py",
    "test": "python3 scripts/test.py",
    "test:browser": "python3 scripts/browser_test.py tests/browser/modules.html tests/browser/app.html tests/browser/midi.html",
    "build:page": "vite build",
    "build:compile": "vite build -c vite.compile.config.js",
    "test:network": "python3 scripts/network_test.py",
    "lint": "eslint src"
  },
  "dependencies": {
    "@cosmos.gl/graph": "^3.4.1",
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.42",
    "vuetify": "^3.13.4",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
